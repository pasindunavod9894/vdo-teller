# Postgres. `docker compose up -d` starts a local one on port 5434 (see docker-compose.yml); keep the password in both lines the same.
DATABASE_URL=postgres://vdo:change-me@127.0.0.1:5434/vdo_teller
POSTGRES_PASSWORD=change-me
PAYLOAD_SECRET=YOUR_SECRET_HERE

# OpenAI (Phase 4+). Without a key the wizard falls back to sample data.
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL_SHOWRUNNER=gpt-5-mini
# OPENAI_MODEL_STYLE=gpt-5-mini        (the Style agent: writes a series' style bible once)
# OPENAI_MODEL_CREATOR=gpt-5-mini      (the Creator: three ideas per video, with web search)
# OPENAI_MODEL_PICKER=gpt-5-mini       (the Story Builder's idea picker)
# OPENAI_MODEL_CRITIC=gpt-5-mini       (the Story Builder's rubric Critic)
# OPENAI_MODEL_ART_DIRECTOR=gpt-5-mini (the shot list by meaning)
# OPENAI_MODEL_EPISODE_STYLE=gpt-5-nano (the mood of one video inside the series look)
# OPENAI_MODEL_REEL_QA=gpt-5-mini      (the vision check of the finished video)
# The Creator searches the web for what currently performs (a few cents per video). off = no search.
# CREATOR_WEB_SEARCH=off
# OPENAI_MODEL_CONTINUITY=gpt-5-mini   (vision check of every clip for character drift; gpt-5 is the strictest)

# Pipeline mode: "mock" (default, free practice run) or "text" (the real language-model agents: Creator, Story Builder, Style, Art Director, Publisher; media follows MEDIA_PROVIDER)
# PIPELINE_MODE=text

# fal.ai video model (Kling 2.5 Turbo Pro by default; the cheaper 'kling-2.5-turbo-standard' can be chosen per series
# once scripts/live-kling-test.ts has confirmed its output size). Every shot of a reel is a clip, and dialogue clips are lip-synced here too. Key from fal.ai/dashboard/keys, "API" preset.
FAL_KEY=
# 'mock' (default, free: FFmpeg stand-in clip) or 'fal' (real clips, costs money; also needs FAL_KEY)
# VIDEO_PROVIDER=fal
# How many of a reel's clips are made at the same time (1 to 8, default 4). Same cost as one at a time, but much faster.
# Lower it if fal answers "too many requests" (HTTP 429).
# VIDEO_CONCURRENCY=4
# How many location plates, keyframes and spoken lines are made at the same time (1 to 8, default 4). Lower it on an OpenAI
# image rate limit (HTTP 429); the retry waits 15 s and tries up to 3 times.
# IMAGE_CONCURRENCY=4

# Media (stills, voices, scoring): 'mock' (default, free placeholder art and tone voices) or 'openai' (real images,
# speech and vision checks; costs money, needs OPENAI_API_KEY and a finished asset pack for every character).
# MEDIA_PROVIDER=openai
# Who draws each character's reference sheet and expressions (made once per series): 'fal' (fal.ai FLUX.2, about $0.07 per
# character, the default when FAL_KEY is set) or 'openai' (gpt-image-2 high quality, about $0.85 per character).
# CHARACTER_IMAGE_PROVIDER=fal
# 'off' skips the media phase entirely (fixture-only practice run, no files, no render).
# MEDIA_PIPELINE=off
# Where episode files (assets, clips, master video) and per-series libraries (plates, character kits) are kept.
# EPISODES_DIR=render/episodes
# SERIES_LIBRARY_DIR=render/series
# Every video is vertical 9:16 at this size: 720p (default, keeps cost down) or 1080p. Exports to other aspects are made from it.
# VIDEO_RESOLUTION=720p
# FFmpeg does all the assembling (needs FFmpeg with libass and libx264). Set these if the binaries are not on the PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# A folder of font files for the captions (default ./fonts when it exists); a missing font falls back to the system one.
# FONTS_DIR=fonts

# A user can make up to 3 videos in any 24 hours (all series together); there is no schedule, the Generate button starts a video.
# Most a user may spend per rolling 24 h across all series, in USD (default 15).
# DAILY_COST_CAP_USD=15

# Cost control (phase 13)
# Master switch for the token/cost savings: output-token caps, patch-style Writer revisions, speech and clip reuse,
# small vision images, resume of a failed episode, and flex pricing. Default: off.
# The safety limits below and the daily/series caps are always on, whatever this says.
# TOKEN_OPTIMIZATION=on
# Most one episode may cost in USD. Default depends on the length of the reel and the video model (about 3 for 10 s, 4 for 15 s, 6 for 30 s).
# EPISODE_COST_CAP_USD=3
# 1 = (needs TOKEN_OPTIMIZATION=on) background runs use OpenAI flex processing: about half price, falls back to normal if unavailable.
# OPENAI_FLEX=1
