DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# OpenAI (Phase 4+). Without a key the wizard falls back to sample data.
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL_SHOWRUNNER=gpt-5-mini

# Pipeline mode: "mock" (default, free practice run) or "text" (real LLM text agents; media agents stay mock)
# PIPELINE_MODE=text

# fal.ai video model (Kling 2.5 Turbo by default). Key from fal.ai/dashboard/keys, "API" preset.
FAL_KEY=
# 'mock' (default, free: FFmpeg stand-in clip) or 'fal' (real clips, costs money; also needs FAL_KEY)
# VIDEO_PROVIDER=fal

# Media (stills, voices, scoring): 'mock' (default, free placeholder art and tone voices) or 'openai' (real images,
# speech and vision checks; costs money, needs OPENAI_API_KEY and a finished asset pack for every character).
# MEDIA_PROVIDER=openai
# 'off' skips the media phase entirely (fixture-only practice run, no files, no render).
# MEDIA_PIPELINE=off
# Where episode files (assets, clips, master video) and per-series libraries (plates, character kits) are kept.
# EPISODES_DIR=render/episodes
# SERIES_LIBRARY_DIR=render/series
# Browser used by the Remotion renderer (defaults to Google Chrome on macOS).
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
